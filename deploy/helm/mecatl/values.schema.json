{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "global", "mecak8s", "mecabroker"],
  "properties": {
    "mode": {"type": "string", "enum": ["managed", "external"]},
    "global": {
      "type": "object", "additionalProperties": false,
      "required": ["mecatl"],
      "properties": {
        "mecatl": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "mcp"],
          "properties": {
            "mode": {"type": "string", "enum": ["managed", "external"]},
            "broker": {
              "type": "object", "additionalProperties": false,
              "required": ["tls", "workloadJWT"],
              "properties": {
                "tls": {"type": "object", "additionalProperties": false, "required": ["caSecret", "caKey", "serverName"], "properties": {"caSecret": {"type": "string"}, "caKey": {"type": "string"}, "serverName": {"type": "string"}}},
                "workloadJWT": {"type": "object", "additionalProperties": false, "required": ["issuer", "jwksURI", "audience", "lifetimeSeconds"], "properties": {"issuer": {"type": "string"}, "jwksURI": {"type": "string"}, "audience": {"type": "string"}, "lifetimeSeconds": {"type": "integer", "minimum": 1}, "trustBundleSecret": {"type": "string"}, "trustBundleKey": {"type": "string"}}}
              }
            },
            "mcp": {
              "type": "object", "additionalProperties": false,
              "required": ["broker", "servers"],
              "properties": {
                "broker": {"type": "object", "additionalProperties": false, "required": ["callbackURL"], "properties": {"callbackURL": {"type": "string"}}},
                "servers": {"type": "array", "items": {
                  "type": "object", "additionalProperties": false, "required": ["name", "url", "auth"],
                  "properties": {
                    "name": {"type": "string", "pattern": "^[A-Za-z0-9_]+$", "not": {"pattern": "__"}},
                    "url": {"type": "string", "pattern": "^https?://[^@/\\s#]+(?:/[^\\s#]*)?$"},
                    "insecureHTTP": {"type": "boolean"},
                    "auth": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {
                      "mode": {"type": "string", "enum": ["none", "staticBearer", "oauth"]},
                      "staticBearer": {"type": "object", "additionalProperties": false, "required": ["secretKeyRef"], "properties": {"secretKeyRef": {"$ref": "#/definitions/secretKeyRef"}}},
                      "oauth": {"type": "object", "additionalProperties": false, "required": ["client", "scopes", "network"], "properties": {
                        "issuer": {"type": "string", "pattern": "^https://[^@/?#\\s]+(?::[0-9]+)?$"},
                        "upstream": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"type": "string", "enum": ["oidc", "oauth2"]}, "oauth2": {"type": "object", "additionalProperties": false, "required": ["authorizationEndpoint", "tokenEndpoint"], "properties": {"authorizationEndpoint": {"type": "string", "pattern": "^https://[^@/?#\\s]+(?:/[^\\s#]*)?$"}, "tokenEndpoint": {"type": "string", "pattern": "^https://[^@/?#\\s]+(?:/[^\\s#]*)?$"}}}}, "oneOf": [{"properties": {"mode": {"const": "oidc"}}, "not": {"required": ["oauth2"]}}, {"properties": {"mode": {"const": "oauth2"}}, "required": ["oauth2"]}]},
                        "client": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"type": "string", "enum": ["preregistered", "cimd", "dcr"]}, "preregistered": {"type": "object", "additionalProperties": false, "required": ["id", "secretKeyRef"], "properties": {"id": {"type": "string", "minLength": 1}, "secretKeyRef": {"$ref": "#/definitions/secretKeyRef"}}}, "cimd": {"type": "object", "additionalProperties": false, "required": ["documentURL"], "properties": {"documentURL": {"type": "string", "pattern": "^https://[^@/\\s#]+/[^\\s#]+$"}}}, "dcr": {"type": "object", "additionalProperties": false, "required": ["discoveryURL"], "properties": {"discoveryURL": {"type": "string", "pattern": "^https://[^@/\\s#]+/[^\\s#]+$"}}}}, "oneOf": [{"properties": {"mode": {"const": "preregistered"}}, "required": ["preregistered"], "not": {"anyOf": [{"required": ["cimd"]}, {"required": ["dcr"]}]}}, {"properties": {"mode": {"const": "cimd"}}, "required": ["cimd"], "not": {"anyOf": [{"required": ["preregistered"]}, {"required": ["dcr"]}]}}, {"properties": {"mode": {"const": "dcr"}}, "required": ["dcr"], "not": {"anyOf": [{"required": ["preregistered"]}, {"required": ["cimd"]}]}}]},
                        "scopes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "requestRefreshToken": {"type": "boolean"}, "network": {"type": "object", "additionalProperties": false, "required": ["additionalOrigins", "privateOrigins", "maxRedirects"], "properties": {"additionalOrigins": {"type": "array", "items": {"type": "string", "pattern": "^https?://[^@/?#\\s]+(?::[0-9]+)?$"}}, "privateOrigins": {"type": "array", "items": {"type": "string", "pattern": "^https?://[^@/?#\\s]+(?::[0-9]+)?$"}}, "maxRedirects": {"type": "integer", "minimum": 0, "maximum": 5}}}, "tools": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "description", "inputSchema"], "properties": {"name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "inputSchema": {"type": "object"}, "readOnly": {"type": "boolean"}}}}
                      }, "oneOf": [{"required": ["issuer"], "not": {"required": ["upstream"]}}, {"required": ["issuer", "upstream"], "properties": {"upstream": {"properties": {"mode": {"const": "oidc"}}}}, "not": {"properties": {"client": {"properties": {"mode": {"const": "dcr"}}}}}}, {"required": ["upstream"], "properties": {"upstream": {"properties": {"mode": {"const": "oauth2"}}}}, "not": {"properties": {"client": {"properties": {"mode": {"const": "dcr"}}}}}}, {"required": ["upstream"], "properties": {"upstream": {"properties": {"mode": {"const": "oauth2"}}}, "client": {"properties": {"mode": {"const": "dcr"}}}}}]}
                    }, "oneOf": [{"properties": {"mode": {"const": "none"}}, "not": {"anyOf": [{"required": ["staticBearer"]}, {"required": ["oauth"]}]}}, {"properties": {"mode": {"const": "staticBearer"}}, "required": ["staticBearer"], "not": {"required": ["oauth"]}}, {"properties": {"mode": {"const": "oauth"}}, "required": ["oauth"], "not": {"required": ["staticBearer"]}}]}
                  }
                }}
              }
            }
          }
        }
      }
    },
    "mecak8s": {"type": "object"},
    "mecabroker": {"type": "object"}
  },
  "definitions": {
    "secretKeyRef": {"type": "object", "additionalProperties": false, "required": ["name", "key"], "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string", "minLength": 1}}}
  }
}
