# ToolHive Cloud UI - Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# LOCAL AGENT HARNESS (OPTIONAL — LOCAL DEVELOPMENT ONLY)
# =============================================================================
# Point the workspace chat at a mecatl daemon running on this machine
# (`mecated serve --workspace <repo> --store-dir <dir>`). When unset or
# unreachable — which is always the case on a deployed instance — the chat falls
# back to simulated responses.
#
# Loopback targets only; a non-loopback MECATL_URL is refused unless
# MECATL_ALLOW_REMOTE=true, because the daemon exposes file, edit and shell tools.
# MECATL_URL=http://127.0.0.1:8081
#
# Absolute path every file and shell tool is rooted at. Required by the daemon on
# session create; injected server-side so it never reaches the client bundle.
# MECATL_WORKSPACE=/absolute/path/to/your/repo
#
# Only if the daemon was started with --auth-token.
# MECATL_AUTH_TOKEN=
#
# Mecatl Studio's local controller (supervises the daemon; provider credential,
# MCP gateway, model routing). Defaults to its standard loopback port.
# MECATL_CONTROL_URL=http://127.0.0.1:8788

# =============================================================================
# REQUIRED FOR PRODUCTION
# =============================================================================

# OIDC Provider Configuration
# Your OIDC provider's issuer URL (e.g., https://your-oidc-provider.com)
OIDC_ISSUER_URL=

# OAuth2 Client ID from your OIDC provider
OIDC_CLIENT_ID=

# OAuth2 Client Secret from your OIDC provider
OIDC_CLIENT_SECRET=

# Better Auth Configuration
# Secret key for token encryption (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Your application's base URL (e.g., https://your-app.example.com)
BETTER_AUTH_URL=

# Backend API Configuration
# ToolHive Registry Server API URL
API_BASE_URL=

# =============================================================================
# OPTIONAL
# =============================================================================

# Brand Customization
# Both vars are runtime environment variables — set them via Helm values or
# Kubernetes env vars. No rebuild required to change them.
#
# Display name used as the logo's alt text (visible to screen readers).
# Read at request time in Server Components. Falls back to "ToolHive" in the
# global error boundary (a Client Component) — accessing runtime env vars
# there would require a server roundtrip, which is unacceptable in a
# last-resort error handler.
# If unset, defaults to "ToolHive".
# BRAND_NAME=Acme Corp

# URL of a custom logo image (SVG, PNG, WebP, etc.).
# Proxied server-side on every request by the /brand/logo route handler —
# the external URL never reaches the browser.
# If unset, the default ToolHive logo is served.
# BRAND_LOGO_URL=https://cdn.example.com/your-logo.svg

# Trusted Origins (comma-separated list)
# Additional origins allowed for CORS and auth callbacks
# TRUSTED_ORIGINS=http://localhost:3002,http://localhost:3003

# Favicon (optional)
# URL of a custom favicon to display in browser tabs.
# If not set, the default Stacklok favicon is used.
# Supported formats: ICO, PNG, SVG, JPEG.
# Next.js recommends a 32x32 ICO for maximum browser compatibility,
# or SVG for a scalable single-format option supported by all modern browsers.
# FAVICON_URL=https://example.com/favicon.ico

# =============================================================================
# DEVELOPMENT ONLY (automatically set by dev server)
# =============================================================================

# These are set automatically when running 'pnpm dev'
# No need to set them manually for local development

# NODE_ENV=development
# OIDC_ISSUER_URL=http://localhost:3001
# OIDC_CLIENT_ID=web-client
# OIDC_CLIENT_SECRET=web-secret
# BETTER_AUTH_URL=http://localhost:3000
# API_BASE_URL=http://localhost:9090

# AI-assistant related tokens
OPENROUTER_API_KEY=my-example-key

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Atrium workspace-only mode is chosen by the USER: the presentation-mode
# dropdown in the user menu ("Atrium" vs "Gateway") hides the Connectors and AI
# Gateway sidebar sections AND blocks their routes (/gateway, /tools/**,
# /admin/**, /workspace/token-usage), which redirect to /workspace/chat. The
# choice is mirrored into a cookie so src/proxy.ts can enforce it server-side.
#
# This variable only sets the DEFAULT for a visitor who has not chosen yet — an
# explicit selection always wins. Leave unset for the full console by default.
# NEXT_PUBLIC_ATRIUM_WORKSPACE_ONLY=true
